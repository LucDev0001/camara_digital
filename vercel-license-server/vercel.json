{
  "version": 2,
  "rewrites": [
    { "source": "/api/verify", "destination": "/api/verify.js" },
    { "source": "/api/licenses", "destination": "/api/licenses.js" },
    { "source": "/", "destination": "/public/index.html" }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, POST, PUT, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type, Authorization, X-Dev-Master-Key" }
      ]
    }
  ]
}

